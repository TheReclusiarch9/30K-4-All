              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Ambulator Frame" hidden="false" id="45d2-c14f-3b09-3770">
                  <profiles>
                    <profile name="Ambulator Frame" hidden="false" id="bc95-9a62-2527-96a9" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" publicationId="892-6266-f55f-1b9d" page="130">
                      <characteristics>
                        <characteristic name="Description" typeId="347e-ee4a-764f-6be3">An Ambulator Frame provides a 2+ Armour Save and grants the It Will Not Die (5+) Special Rule.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6227-3c5f-b349-2bd1"/>
