          <selectionEntries>
            <selectionEntry type="model" name="Ireton MaSade" id="5915-2e6b-40fb-bceb" page="130" publicationId="892-6266-f55f-1b9d">
              <profiles>
                <profile id="15df-f7df-443b-b8f8" name="Ireton MaSade" typeId="4bb2-cb95-e6c8-5a21">
