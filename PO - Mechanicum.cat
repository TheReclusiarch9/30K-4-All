      <comment>!BSC Errors from 20240406-1709
Could not find rule: Independent Character
Could not find rule: Command Protocols (Skitarius)</comment>
      <rules>
        <rule name="Command Protocols (Skitarius)" hidden="false" id="975a-f8cd-9f13-b4ae" publicationId="f856-58d6-ef02-7d3e" page="90">
          <description>Once per game, at the start of the Controlling Player’s Shooting phase, you may nominate one unit with the Skitarii Sub-type unit within 12” of this model. This unit can re-roll failed to Hit rolls of 1 during that Shooting Phase.</description>
        </rule>
      </rules>
