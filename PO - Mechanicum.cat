      <rules>
        <rule name="Command Protocols (Kill-Clade)" id="bad1-a128-616c-6ffe" hidden="false" publicationId="f856-58d6-ef02-7d3e" page="90">
          <description>This model, and any unit it has joined, may re-roll the dice for determining Charge distances.
In addition, if a model with this Special Rule is your Warlord, all Sicarian Kill-Clades in the same Detachment gain the Line Sub-type for as long as they have not been removed as a casualty.</description>
        </rule>
      </rules>
