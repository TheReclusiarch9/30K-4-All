                <characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic>
                <characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Phoenix Lord (Asuryani, Unique)</characteristic>
              </characteristics>
            </profile>
            <profile name="The Duellist’s Fury" hidden="false" id="6251-ed83-b9b1-422f" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" publicationId="a368-64f0-10c7-c49d" page="96">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">If chosen as the army’s Warlord, Karandras automatically has The Duellist’s Fury as their Warlord Trait and may not select any other Warlord Trait.
On a turn in which a unit with the Aspect Shrine (Striking Scorpion) Special Rule charges, or is successfully charged, they gain the Riposte (1) Special Rule, and improve their Counter-Attack (X) and Rage (X) Special Rules values by 1.
In addition, an army that includes a Warlord with this Trait may make an additional Reaction in the Assault phase as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
